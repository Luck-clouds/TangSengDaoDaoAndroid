<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="15dp"
    android:orientation="horizontal">

    <com.chat.base.ui.components.AvatarView
        android:id="@+id/avatarView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/nameTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/color999"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/timeTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color999"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/contentTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/send_chat_text_bg"
            android:textColor="@color/colorDark"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/forwardVoiceLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/send_chat_text_bg"
            android:orientation="horizontal"
            android:paddingStart="@dimen/chat_bubble_padding_lr"
            android:paddingTop="@dimen/chat_bubble_padding_tb"
            android:paddingEnd="@dimen/chat_bubble_padding_lr"
            android:paddingBottom="@dimen/chat_bubble_padding_tb"
            android:visibility="gone">

            <com.chat.uikit.view.CircleProgress
                android:id="@+id/forwardVoicePlayBtn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:shadowColor="@color/homeColor" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:orientation="vertical">

                <com.chat.uikit.view.WaveformView
                    android:id="@+id/forwardVoiceWaveform"
                    android:layout_width="150dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="5dp"
                    android:textColor="?attr/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/forwardVoiceTimeTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/color999"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:src="@drawable/default_view_bg" />

            <com.chat.base.views.CircularProgressView
                android:id="@+id/progressView"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="center"
                android:visibility="visible"
                app:backColor="@color/white"
                app:backWidth="2dp"
                app:progColor="@color/color999"
                app:progWidth="2dp"
                app:progress="0" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/playIv"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@mipmap/icon_play" />
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/gifIv"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:src="@drawable/default_view_bg" />

        <View
            android:id="@+id/viewLine"
            style="@style/view_line"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />
    </LinearLayout>
</LinearLayout>
