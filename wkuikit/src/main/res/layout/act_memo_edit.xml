<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/wk_title_bar_layout" />

    <EditText
        android:id="@+id/memoTitleEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:hint="@string/memo_title_hint"
        android:inputType="textCapSentences"
        android:maxLength="100"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:singleLine="true"
        android:textColor="@color/colorDark"
        android:textColorHint="@color/color999"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:background="@color/clrCCC" />

    <EditText
        android:id="@+id/memoContentEt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@null"
        android:gravity="top|start"
        android:hint="@string/memo_content_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="20000"
        android:padding="18dp"
        android:scrollbars="vertical"
        android:textColor="@color/colorDark"
        android:textColorHint="@color/color999"
        android:textSize="16sp" />
</LinearLayout>
